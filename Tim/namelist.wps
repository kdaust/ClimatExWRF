&share
 wrf_core = 'ARW',
 max_dom = 4,
 start_date = '2019-09-04_12:00:00','2019-09-04_12:00:00',
 end_date   = '2019-09-06_00:00:00','2019-09-04_12:00:00',
 interval_seconds = 10800
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   0, 1, 2, 3,
 parent_grid_ratio =   1, 3, 3, 3,
 i_parent_start    =   1, 20, 93, 201,
 j_parent_start    =   1, 24, 143, 93,
 e_we              =  164, 370, 559, 301,
 e_sn              =  203, 466, 703, 361,
 geog_data_res = '30m+default','default','default','default',
 dx = 27000,
 dy = 27000,
 map_proj = 'polar',
 ref_lat   =  53.00,
 ref_lon   = -124.00,
 truelat1  =  60.0,
 truelat2  =  90.0,
 stand_lon = -90.0,
 geog_data_path = '/scratch/tchui/GEOGV4.3.3'
 opt_geogrid_tbl_path = '.'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE'
 io_form_metgrid = 2,
 opt_metgrid_tbl_path = '.'
/
